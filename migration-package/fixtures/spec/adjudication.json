            "summary.amount_diff_total": 680.02,
            "summary.excluded_amount_total": 0.0
          }
        },
        {
          "id": "exclude",
          "label": "不计入（视为同一经济价值的两种口径表述）",
          "implies": {
            "summary.amount_diff_total": 500.02,
            "summary.excluded_amount_total": 180.0
          }
        }
      ],
      "status": "unresolved"
    },
