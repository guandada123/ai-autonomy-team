"""EX-02 · 对立面执行体：TASK-SYNTH-RECON-001 双立场计算（甲/乙）"""
import csv, json
from collections import Counter
from decimal import Decimal

FIX = "C:/Users/Administrator/WorkBuddy/2026-10-16-14-46-19/migration-package/fixtures"
OUT = "C:/Users/Administrator/WorkBuddy/2026-10-16-14-46-19/migration-package/runs/round1/EX-02.json"
TAX = Decimal("1.06")          # 口径判定比率（数据内双样本精确一致）
ROUND_CENT = Decimal("0.02")   # 舍入差定义边界：分级（分级差异且可整除于分位）

def load(p):
    with open(p, newline="", encoding="utf-8-sig") as f:
        rows = list(csv.DictReader(f))
    for r in rows:
        r["amount"] = Decimal(r["amount"].strip())
    return rows

L, B = load(FIX + "/ledger.csv"), load(FIX + "/bill.csv")
ledger_rows, bill_rows = len(L), len(B)
ledger_total, bill_total = sum(r["amount"] for r in L), sum(r["amount"] for r in B)
raw_gap = bill_total - ledger_total

# ---- B. 重复项（同一单号在同一文件内多行）----
lc, bc = Counter(r["txn_id"] for r in L), Counter(r["txn_id"] for r in B)
dup_ids = sorted(t for t in (set(lc) | set(bc)) if lc[t] > 1 or bc[t] > 1)
firstL, firstB = {}, {}
for r in L: firstL.setdefault(r["txn_id"], r)
for r in B: firstB.setdefault(r["txn_id"], r)
dedup_amount = Decimal("0")
for t in dup_ids:
    if lc[t] > 1: dedup_amount += sum(r["amount"] for r in L if r["txn_id"] == t) - firstL[t]["amount"]
    if bc[t] > 1: dedup_amount += sum(r["amount"] for r in B if r["txn_id"] == t) - firstB[t]["amount"]

# ---- C. 差异分类（结构规则，note 仅作旁证不参与判定）----
entries = []
for t in sorted(set(firstL) | set(firstB)):
    lrow, brow = firstL.get(t), firstB.get(t)
    if t in dup_ids:
        # 契约规定：重复项金额只由 dedup_amount 表达，不进两个金额差异桶
        entries.append({"id": t, "cat": "重复导入", "yi_counted": None, "abs": None, "signed": Decimal("0")})
        continue
    la = lrow["amount"] if lrow else Decimal("0")
    ba = brow["amount"] if brow else Decimal("0")
    a, s = abs(la - ba), ba - la
    if lrow and brow:
        if la == ba and lrow["date"] != brow["date"]:
            cat, yi = "跨月归属", False          # 金额一致、归属期不同 → 差额为 0
        elif lrow["tax_included"] != brow["tax_included"] and (la == ba * TAX or ba == la * TAX):
            cat, yi = "口径差异", False          # 含税口径不同且 ×1.06 精确闭环 → 可完全解释
        elif a != 0 and a <= ROUND_CENT:
            cat, yi = "舍入差", True             # 分位级差异，无精确换算可归零 → 计入
        elif a != 0:
            cat, yi = "其他金额差异", True
        else:
            continue                              # 完全一致，非差异
    else:
        cat, yi = "单边缺失", True                # 一侧缺行，另一侧金额视差额全额
    entries.append({"id": t, "cat": cat, "yi_counted": yi, "abs": a, "signed": s})

# ---- 双立场合计 ----
non_dup = [x for x in entries if x["cat"] != "重复导入"]
jia_amount = sum(x["abs"] for x in non_dup)                                  # 甲：全部计入
jia_excl   = Decimal("0")
yi_amount  = sum(x["abs"] for x in non_dup if x["yi_counted"])                # 乙：排除可完全解释项
yi_excl    = sum(x["abs"] for x in non_dup if not x["yi_counted"])
yi_cats    = sorted({x["cat"] for x in non_dup if not x["yi_counted"]})

# ---- 自检断言（数字全部由数据算出，不接受手填）----
assert ledger_rows == 27 and bill_rows == 27
assert ledger_total == Decimal("37490.50") and bill_total == Decimal("38010.52")
assert raw_gap == Decimal("520.02")
assert len(dup_ids) == 1 and dedup_amount == Decimal("1200.00")
assert len(entries) == 7 and len(non_dup) == 6
# 完整性闭环：去重金额 + Σ(账单−台账) 必须精确等于 raw_total_gap（差异清单无遗漏）
assert sum(x["signed"] for x in entries) + dedup_amount == raw_gap
assert yi_amount == Decimal("500.02") and yi_excl == Decimal("180.00")
assert jia_amount == Decimal("680.02") and yi_amount + yi_excl == jia_amount

def f(d): return float(d)
cats = {}
for x in entries: cats.setdefault(x["cat"], []).append(x["id"])

