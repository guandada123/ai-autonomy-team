root = true

# 全项目统一：UTF-8、LF、末尾留一个换行、去行尾空白。
# 本项目有大量中文文档与「逐字节比对」的门禁（build_package --check /
# regress 第 8 项），换行或编码漂移会直接让门禁变红，所以这条不是风格偏好。
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,json,yml,yaml,toml}]
indent_size = 2

# Makefile 必须用 tab，否则 make 直接报 missing separator
[Makefile]
indent_style = tab

[*.{frozen,jsonl}]
# 冻结基线与日志：逐字节比对的对象，任何自动格式化都不能碰
trim_trailing_whitespace = false
insert_final_newline = false
