root = true

# 全项目统一：UTF-8、LF、末尾留一个换行、去行尾空白。
# 本项目有大量中文文档与「逐字节比对」的门禁（build_package --check /
# regress 第 8 项），换行或编码漂移会直接让门禁变红，所以这条不是风格偏好。
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,json,yml,yaml,toml}]
indent_size = 2

# Makefile 必须用 tab，否则 make 直接报 missing separator
[Makefile]
indent_style = tab

# ── 关于 *.frozen / *.jsonl ────────────────────────────────────────────
# 这两类文件参与逐字节比对（truth.json.frozen 是 regress 第 8 项的基线），
# **不要手工格式化**。
#
# 但不要为它们单独关掉末尾换行：实测 truth.json.frozen 最后 1 字节是 0x0A，
# 即它本身就以换行结尾。此前这里写过 `insert_final_newline = false`，
# 与文件实际相反 —— 遵守 editorconfig 的编辑器一保存就会删掉那个换行，
# regress 第 8 项随即变红，而修复动作变成"把编辑器改坏的东西改回来"。
# （2026-10-23 审计修正：配置必须与文件实际一致，不能凭"冻结文件不该有换行"的直觉。）
#
# 故此处**不设任何覆盖**，沿用上面的全局规则（LF + 末尾一个换行 + 去行尾空白）。
